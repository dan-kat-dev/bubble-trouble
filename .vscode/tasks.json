{
  // Run with Terminal > Run Task.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vite dev server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      // Starts SketchUp with Ruby's debug port open, for "Attach to SketchUp Ruby".
      // Needs SketchUp's Ruby debugger DLL (see README > Desktop > Debugging).
      "label": "SketchUp with Ruby debugger",
      "type": "process",
      "command": "${input:sketchupExe}",
      "args": ["-rdebug", "ide port=7000"],
      "isBackground": true,
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "sketchupExe",
      "type": "promptString",
      "description": "Path to SketchUp.exe",
      "default": "C:\\Program Files\\SketchUp\\SketchUp 2026\\SketchUp.exe"
    }
  ]
}
