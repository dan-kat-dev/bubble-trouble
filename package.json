{
  "name": "bubble-trouble",
  "version": "0.1.0",
  "private": true,
  "description": "A visual outliner extension for SketchUp (JavaScript API).",
  "type": "module",
  "scripts": {
    "certs": "node scripts/certs.ts",
    "dev": "node scripts/dev-manifest.ts && vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "zip": "npm run build && node scripts/zip.ts"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "archiver": "^8.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "d3-force": "^3.0.1",
    "d3-hierarchy": "^3.1.3",
    "vue": "^3.5.45"
  }
}
